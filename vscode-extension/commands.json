  {
    "name": "over",
    "snippet": "\\over{${1:top}}{${2:main}}",
    "doc": "Place the first argument directly over the second: `\\over{top}{main}`.",
    "params": [
      { "label": "top", "doc": "Content placed above." },
      { "label": "main", "doc": "The element it sits over." }
    ]
  },
  {
    "name": "under",
    "snippet": "\\under{${1:bottom}}{${2:main}}",
    "doc": "Place the first argument directly under the second: `\\under{bottom}{main}`.",
    "params": [
      { "label": "bottom", "doc": "Content placed below." },
      { "label": "main", "doc": "The element it sits under." }
    ]
  },
  {
    "name": "cancel",
    "snippet": "\\cancel{${1:content}}",
    "doc": "Strikethrough from top right to bottom left.",
    "params": [
      { "label": "content", "doc": "Content to cross out." }
    ]
  },
  {
    "name": "cancelangle",
    "snippet": "\\cancelangle{${1:angle}}{${2:content}}",
    "doc": "Strikethrough at a custom angle.",
    "params": [
      { "label": "angle", "doc": "Angle in degrees." },
      { "label": "content", "doc": "Content to cross out." }
    ]
  },
  {
    "name": "canceldir",
    "snippet": "\\canceldir{${1|tlbr,trbl,ud,lr|}}{$2}",
    "doc": "Strikethrough in a chosen direction (`tlbr`, `trbl`, `ud`, `lr`, plus aliases like `diag`, `vert`, `horiz`).",
    "params": [
      { "label": "direction", "doc": "tlbr, trbl, ud or lr (see documentation for aliases)." },
      { "label": "content", "doc": "Content to cross out." }
    ]
  },
  {
    "name": "frac",
    "snippet": "\\frac{${1:numerator}}{${2:denominator}}",
    "doc": "Fraction with a horizontal line: `\\frac{numerator}{denominator}`.",
    "params": [
      { "label": "numerator", "doc": "Top part." },
      { "label": "denominator", "doc": "Bottom part." }
    ]
  },
  {
    "name": "atop",
    "snippet": "\\atop{${1:top}}{${2:bottom}}",
    "doc": "Like `\\frac`, but without the horizontal line.",
    "params": [
      { "label": "top", "doc": "Top part." },
      { "label": "bottom", "doc": "Bottom part." }
    ]
  },
  {
    "name": "root",
    "snippet": "\\root{${1:index}}{${2:content}}",
    "doc": "N-th root: `\\root{index}{content}`.",
    "params": [
      { "label": "index", "doc": "The root index (e.g. 3 for a cube root)." },
      { "label": "content", "doc": "What the root is taken of." }
    ]
  },
  {
    "name": "attach",
    "snippet": "\\attach{$1}{$2}{$3}{$4}{$5}{$6}{$7}",
    "doc": "Attach scripts around a main element. Leave unused slots empty: `\\attach{AB}{}{}{Above}{}{}{}`.",
    "params": [
      { "label": "main", "doc": "The element the scripts attach to." },
      { "label": "top-right", "doc": "Superscript position (top right)." },
      { "label": "bottom-right", "doc": "Subscript position (bottom right)." },
      { "label": "top-left", "doc": "Top left script." },
      { "label": "bottom-left", "doc": "Bottom left script." },
      { "label": "up", "doc": "Placed directly above the main element." },
      { "label": "down", "doc": "Placed directly below the main element." }
    ]
  },
  {
    "name": "attacho",
    "snippet": "\\attacho{$1}{$2}{$3}{$4}{$5}{$6}{$7}{$8}",
    "doc": "Like `\\attach`, with an extra overlap parameter.",
    "params": [
      { "label": "main", "doc": "The element the scripts attach to." },
      { "label": "top-right", "doc": "Superscript position (top right)." },
      { "label": "bottom-right", "doc": "Subscript position (bottom right)." },
      { "label": "top-left", "doc": "Top left script." },
      { "label": "bottom-left", "doc": "Bottom left script." },
      { "label": "up", "doc": "Placed directly above the main element." },
      { "label": "down", "doc": "Placed directly below the main element." },
      { "label": "overlap", "doc": "Overlap in em that pulls the scripts closer to the main element (default 0.3em)." }
    ]
  },
  {
    "name": "attachos",
    "snippet": "\\attachos{$1}{$2}{$3}{$4}{$5}{$6}{$7}{$8}{$9}",
    "doc": "Like `\\attacho`, with an extra parameter for the scale of the attached elements.",
    "params": [
      { "label": "main", "doc": "The element the scripts attach to." },
      { "label": "top-right", "doc": "Superscript position (top right)." },
      { "label": "bottom-right", "doc": "Subscript position (bottom right)." },
      { "label": "top-left", "doc": "Top left script." },
      { "label": "bottom-left", "doc": "Bottom left script." },
      { "label": "up", "doc": "Placed directly above the main element." },
      { "label": "down", "doc": "Placed directly below the main element." },
      { "label": "overlap", "doc": "Overlap in em that pulls the scripts closer to the main element (default 0.3em)." },
      { "label": "scale", "doc": "Scale of the attached elements (default 0.6)." }
    ]
  },
